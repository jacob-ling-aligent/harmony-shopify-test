{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Harmony to Shopify Test Inventory Delta Service",
  "Resources": {
    "ServerlessDeploymentBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        }
      }
    },
    "ServerlessDeploymentBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "ServerlessDeploymentBucket"
        },
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "s3:*",
              "Effect": "Deny",
              "Principal": "*",
              "Resource": [
                {
                  "Fn::Join": [
                    "",
                    [
                      "arn:",
                      {
                        "Ref": "AWS::Partition"
                      },
                      ":s3:::",
                      {
                        "Ref": "ServerlessDeploymentBucket"
                      },
                      "/*"
                    ]
                  ]
                },
                {
                  "Fn::Join": [
                    "",
                    [
                      "arn:",
                      {
                        "Ref": "AWS::Partition"
                      },
                      ":s3:::",
                      {
                        "Ref": "ServerlessDeploymentBucket"
                      }
                    ]
                  ]
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": false
                }
              }
            }
          ]
        }
      }
    },
    "GetProductUpdatesLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/hstest-int-stock-dev-getProductUpdates"
      }
    },
    "WorldLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/hstest-int-stock-dev-world"
      }
    },
    "IamRoleLambdaExecution": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "lambda.amazonaws.com"
                ]
              },
              "Action": [
                "sts:AssumeRole"
              ]
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": {
              "Fn::Join": [
                "-",
                [
                  "hstest-int-stock",
                  "dev",
                  "lambda"
                ]
              ]
            },
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:CreateLogGroup",
                    "logs:TagResource"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/hstest-int-stock-dev*:*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:PutLogEvents"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/hstest-int-stock-dev*:*:*"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:*"
                  ],
                  "Resource": "arn:aws:s3:::hstest-int-stock-dev-bucket/*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "xray:PutTraceSegments",
                    "xray:PutTelemetryRecords"
                  ],
                  "Resource": [
                    "*"
                  ]
                }
              ]
            }
          }
        ],
        "Path": "/",
        "RoleName": {
          "Fn::Join": [
            "-",
            [
              "hstest-int-stock",
              "dev",
              {
                "Ref": "AWS::Region"
              },
              "lambdaRole"
            ]
          ]
        }
      }
    },
    "GetProductUpdatesLambdaFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Code": {
          "S3Bucket": {
            "Ref": "ServerlessDeploymentBucket"
          },
          "S3Key": "serverless/hstest-int-stock/dev/1746074701971-2025-05-01T04:45:01.971Z/getProductUpdates.zip"
        },
        "Handler": "src/lambda/get-product-updates.handler",
        "Runtime": "nodejs20.x",
        "FunctionName": "hstest-int-stock-dev-getProductUpdates",
        "MemorySize": 192,
        "Timeout": 6,
        "TracingConfig": {
          "Mode": "Active"
        },
        "Environment": {
          "Variables": {
            "NODE_OPTIONS": "--enable-source-maps",
            "s3BucketName": "hstest-int-stock-dev-bucket"
          }
        },
        "Role": {
          "Fn::GetAtt": [
            "IamRoleLambdaExecution",
            "Arn"
          ]
        }
      },
      "DependsOn": [
        "GetProductUpdatesLogGroup"
      ]
    },
    "WorldLambdaFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "Code": {
          "S3Bucket": {
            "Ref": "ServerlessDeploymentBucket"
          },
          "S3Key": "serverless/hstest-int-stock/dev/1746074701971-2025-05-01T04:45:01.971Z/world.zip"
        },
        "Handler": "src/lambda/world.handler",
        "Runtime": "nodejs20.x",
        "FunctionName": "hstest-int-stock-dev-world",
        "MemorySize": 192,
        "Timeout": 6,
        "TracingConfig": {
          "Mode": "Active"
        },
        "Environment": {
          "Variables": {
            "NODE_OPTIONS": "--enable-source-maps"
          }
        },
        "Role": {
          "Fn::GetAtt": [
            "IamRoleLambdaExecution",
            "Arn"
          ]
        }
      },
      "DependsOn": [
        "WorldLogGroup"
      ]
    },
    "WorldLambdaVersionJFKR6oyqFtEBJiyPwtqbRLNCUoYGZ3RwyUHY8pT9Hs": {
      "Type": "AWS::Lambda::Version",
      "DeletionPolicy": "Retain",
      "Properties": {
        "FunctionName": {
          "Ref": "WorldLambdaFunction"
        },
        "CodeSha256": "3WiT2/JKoxjo3OaOfjAzuk1IoUX16cFGoQMAz+8ew9k="
      }
    },
    "GetProductUpdatesLambdaVersionkuxBw4bVgzDzPKUFNoQF6PsfGfUEeq0r97Z5DHurg": {
      "Type": "AWS::Lambda::Version",
      "DeletionPolicy": "Retain",
      "Properties": {
        "FunctionName": {
          "Ref": "GetProductUpdatesLambdaFunction"
        },
        "CodeSha256": "Uok6rZGuUJbD7Ulomhia1/cYRR5A9uiQ7bafGn/DxwI="
      }
    },
    "HstestDashintDashstockDashdevDashdeltaStockSyncRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": {
                  "Fn::Sub": "states.${AWS::Region}.amazonaws.com"
                }
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "dev-hstest-int-stock-statemachine",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "lambda:InvokeFunction"
                  ],
                  "Resource": [
                    {
                      "Fn::GetAtt": [
                        "GetProductUpdatesLambdaFunction",
                        "Arn"
                      ]
                    },
                    {
                      "Fn::Sub": [
                        "${functionArn}:*",
                        {
                          "functionArn": {
                            "Fn::GetAtt": [
                              "GetProductUpdatesLambdaFunction",
                              "Arn"
                            ]
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "xray:PutTraceSegments",
                    "xray:PutTelemetryRecords",
                    "xray:GetSamplingRules",
                    "xray:GetSamplingTargets"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "HstestDashintDashstockDashdevDashdeltaStockSync": {
      "Type": "AWS::StepFunctions::StateMachine",
      "Properties": {
        "DefinitionString": {
          "Fn::Sub": [
            "{\n  \"StartAt\": \"getProductUpdates\",\n  \"States\": {\n    \"getProductUpdates\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"${cd15051eb5b9b13af8b02fe88fb04d5a}\",\n      \"Next\": \"Stop\"\n    },\n    \"Stop\": {\n      \"Type\": \"Pass\",\n      \"End\": true\n    }\n  }\n}",
            {
              "cd15051eb5b9b13af8b02fe88fb04d5a": {
                "Fn::GetAtt": [
                  "GetProductUpdatesLambdaFunction",
                  "Arn"
                ]
              }
            }
          ]
        },
        "RoleArn": {
          "Fn::GetAtt": [
            "HstestDashintDashstockDashdevDashdeltaStockSyncRole",
            "Arn"
          ]
        },
        "TracingConfiguration": {
          "Enabled": true
        },
        "StateMachineName": "hstest-int-stock-dev-deltaStockSync"
      },
      "DependsOn": [
        "HstestDashintDashstockDashdevDashdeltaStockSyncRole"
      ]
    },
    "Storage": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": "hstest-int-stock-dev-bucket"
      }
    }
  },
  "Outputs": {
    "ServerlessDeploymentBucketName": {
      "Value": {
        "Ref": "ServerlessDeploymentBucket"
      },
      "Export": {
        "Name": "sls-hstest-int-stock-dev-ServerlessDeploymentBucketName"
      }
    },
    "WorldLambdaFunctionQualifiedArn": {
      "Description": "Current Lambda function version",
      "Value": {
        "Ref": "WorldLambdaVersionJFKR6oyqFtEBJiyPwtqbRLNCUoYGZ3RwyUHY8pT9Hs"
      },
      "Export": {
        "Name": "sls-hstest-int-stock-dev-WorldLambdaFunctionQualifiedArn"
      }
    },
    "GetProductUpdatesLambdaFunctionQualifiedArn": {
      "Description": "Current Lambda function version",
      "Value": {
        "Ref": "GetProductUpdatesLambdaVersionkuxBw4bVgzDzPKUFNoQF6PsfGfUEeq0r97Z5DHurg"
      },
      "Export": {
        "Name": "sls-hstest-int-stock-dev-GetProductUpdatesLambdaFunctionQualifiedArn"
      }
    },
    "HstestDashintDashstockDashdevDashdeltaStockSyncArn": {
      "Description": "Current StateMachine Arn",
      "Value": {
        "Ref": "HstestDashintDashstockDashdevDashdeltaStockSync"
      },
      "Export": {
        "Name": "sls-hstest-int-stock-dev-HstestDashintDashstockDashdevDashdeltaStockSyncArn"
      }
    }
  }
}